{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diwali2026",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "diwali2026.interioring.com", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/g/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diwali2026",
      "database_id": "2893a941-aabe-46d1-a3cd-5c8953a5bafd",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_GREETINGS", "namespace_id": "2026001", "simple": { "limit": 12, "period": 60 } }
  ]
}
